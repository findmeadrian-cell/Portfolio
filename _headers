# Security headers for Cloudflare Pages.
# Cloudflare reads this file automatically and sends these headers with every page.
# (GitHub Pages ignores it.)

/*
  # Only load scripts, styles, fonts and images from this site and Google Fonts
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  # Always use HTTPS (only add your domain to the browser preload list once HTTPS works everywhere)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Stop other sites showing this site inside a frame (clickjacking)
  X-Frame-Options: DENY
  # Stop browsers guessing file types
  X-Content-Type-Options: nosniff
  # Share only the domain, not the full page address, when visitors click links out
  Referrer-Policy: strict-origin-when-cross-origin
  # Turn off device features the site doesn't use
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
